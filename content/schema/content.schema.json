{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interviewprep.local/schema/content.schema.json",
  "title": "InterviewPrep content seed file",
  "description": "One file per taxonomy topic: content/<domain>/<topic>.json. Slugs and ids are stable identifiers; never rename, deprecate instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "topic", "concepts"],
  "properties": {
    "domain": { "$ref": "#/$defs/slug", "description": "Domain slug from specs/000-taxonomy.md (e.g. dotnet)." },
    "topic": { "$ref": "#/$defs/slug", "description": "Topic slug within the domain (e.g. clr-memory)." },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/concept" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "level": {
      "type": "string",
      "enum": ["M", "S", "L"],
      "description": "Target level: M = mid, S = senior, L = lead."
    },
    "language": {
      "type": "string",
      "enum": ["en", "uk"]
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "conceptTranslation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "note"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "note": {
          "type": "string",
          "minLength": 200,
          "description": "Markdown. EN target 300-900 words; include a code sample when the concept is code-bound. Code, identifiers and framework terms are never translated."
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "level", "translations", "questions"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "level": { "$ref": "#/$defs/level" },
        "translations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en"],
          "properties": {
            "en": { "$ref": "#/$defs/conceptTranslation" },
            "uk": { "$ref": "#/$defs/conceptTranslation" }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        },
        "katas": {
          "type": "array",
          "items": { "$ref": "#/$defs/kata" }
        }
      }
    },
    "questionId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.(mcq|open)\\.[0-9]+$",
      "description": "<domain>.<topic>.<concept>.<type>.<n>"
    },
    "kataId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.kata\\.[0-9]+$",
      "description": "<domain>.<topic>.<concept>.kata.<n>"
    },
    "mcqOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "correct"],
      "properties": {
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "correct": { "type": "boolean" }
      }
    },
    "questionTranslation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "explanation"],
      "properties": {
        "prompt": { "$ref": "#/$defs/nonEmptyString" },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/mcqOption" },
          "description": "MCQ only. Exactly four options, exactly one correct."
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "description": "Why the correct answer is correct AND why each wrong option is wrong."
        },
        "rubric": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "description": "Open questions only. 3-5 bullet criteria the grader checks."
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "level", "reviewed", "translations", "tags"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "type": { "type": "string", "enum": ["mcq", "open"] },
        "level": { "$ref": "#/$defs/level" },
        "reviewed": { "type": "boolean" },
        "translations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en"],
          "properties": {
            "en": { "$ref": "#/$defs/questionTranslation" },
            "uk": { "$ref": "#/$defs/questionTranslation" }
          }
        },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/slug" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "mcq" } } },
          "then": {
            "properties": {
              "translations": {
                "properties": {
                  "en": { "required": ["options"], "not": { "required": ["rubric"] } },
                  "uk": { "required": ["options"] }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "open" } } },
          "then": {
            "properties": {
              "translations": {
                "properties": {
                  "en": { "required": ["rubric"], "not": { "required": ["options"] } },
                  "uk": { "required": ["rubric"] }
                }
              }
            }
          }
        }
      ]
    },
    "kataTranslation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "rubric", "referenceSolution"],
      "properties": {
        "task": { "$ref": "#/$defs/nonEmptyString" },
        "rubric": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "referenceSolution": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "kata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "language", "reviewed", "translations", "timeLimitMinutes"],
      "properties": {
        "id": { "$ref": "#/$defs/kataId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "language": { "type": "string", "enum": ["csharp", "typescript", "sql"] },
        "reviewed": { "type": "boolean" },
        "translations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en"],
          "properties": {
            "en": { "$ref": "#/$defs/kataTranslation" },
            "uk": { "$ref": "#/$defs/kataTranslation" }
          }
        },
        "timeLimitMinutes": { "type": "integer", "minimum": 5, "maximum": 120 }
      }
    }
  }
}
