# Copy to .env and adjust. The real .env is git-ignored and never written by tooling.

# --- PostgreSQL (docker compose service "postgres") ---
POSTGRES_USER=interviewprep
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interviewprep
# Host port for the database (container always listens on 5432)
POSTGRES_PORT=5432

# --- Ports exposed on the host ---
API_PORT=8080
WEB_PORT=80

# --- API ---
# Where the api container finds the seed content (./content is mounted read-only there)
CONTENT_DIR=/content
# How long the API waits for the database before giving up at start-up
DB_STARTUP_TIMEOUT_SECONDS=90
# Development enables Swagger at /swagger and verbose logs
ASPNETCORE_ENVIRONMENT=Production

# --- Anthropic (feature 004; the app is fully usable for MCQ/notes without a key) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Developer tooling only (postgres MCP server in .mcp.json) ---
DATABASE_URI=postgresql://interviewprep:change-me@localhost:5432/interviewprep
